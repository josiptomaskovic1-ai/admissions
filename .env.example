# Public Cal.com event URL, for example: https://cal.com/virelaadmissions/intro
NEXT_PUBLIC_CAL_LINK=

# Public contact address shown on the contact page.
NEXT_PUBLIC_CONTACT_EMAIL=

# Absolute production origin used for social metadata after deployment.
NEXT_PUBLIC_SITE_URL=https://virela-admissions.friesenjung.chatgpt.site

# Keep false until operator identity, contact details, terms and calendar DPA are complete.
NEXT_PUBLIC_PUBLIC_LAUNCH=false

# A separate safety gate: set true only after legal/operator details have been reviewed and published.
NEXT_PUBLIC_LEGAL_READY=false
