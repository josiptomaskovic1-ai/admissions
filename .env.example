# Public Calendly profile or team event URL.
NEXT_PUBLIC_CAL_LINK=https://calendly.com/adria-admissions

# Public contact address shown on the contact page.
NEXT_PUBLIC_CONTACT_EMAIL=adria.admissions@gmail.com

# Public company profile shown on the contact page and in the footer.
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/adria-admissions/

# Public Instagram profile shown on the contact page and in the footer.
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/adria.admissions/

# Absolute production origin used for social metadata.
NEXT_PUBLIC_SITE_URL=https://adriaadmissions.com

# Keep false until operator identity, contact details, terms and calendar DPA are complete.
NEXT_PUBLIC_PUBLIC_LAUNCH=false

# A separate safety gate: set true only after legal/operator details have been reviewed and published.
NEXT_PUBLIC_LEGAL_READY=false
