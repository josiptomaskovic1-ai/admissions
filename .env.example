# Public Cal.com event URL, for example: https://cal.com/virelaadmissions/intro
# When unset, the booking button falls back to a mailto: link (see app/page.tsx).
NEXT_PUBLIC_CAL_LINK=https://cal.com/virelaadmissions/intro

# Absolute production origin used for canonical/OG/sitemap/robots metadata.
# This is a NEXT_PUBLIC_ var: it is inlined at BUILD time, so it must be set in
# the production build environment (Cloudflare/wrangler build vars), not only here.
# .env.example is documentation only and is not loaded by the build.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example
